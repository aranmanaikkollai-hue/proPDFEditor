<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Signing keys (PKCS#12 files imported by the user) must never be backed up. -->
        <exclude domain="file" path="keystores/" />
        <exclude domain="database" path="batch_jobs.db" />
        <exclude domain="database" path="batch_jobs.db-wal" />
        <exclude domain="database" path="batch_jobs.db-shm" />
        <exclude domain="database" path="batch_jobs.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="keystores/" />
        <exclude domain="database" path="batch_jobs.db" />
        <exclude domain="database" path="batch_jobs.db-wal" />
        <exclude domain="database" path="batch_jobs.db-shm" />
        <exclude domain="database" path="batch_jobs.db-journal" />
    </device-transfer>
</data-extraction-rules>
