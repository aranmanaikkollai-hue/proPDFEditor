<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ProPDFApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProPDF.Starting"
        tools:targetApi="34">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ProPDF.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.scanner.DocumentScannerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.scanner.ModernScannerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ocr.OcrActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ocr.OcrCropActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tools.ToolsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.viewer.ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize" />

        <!-- Legacy-namespace signature suite (com.propdfeditor.ui.signature.*).
             Previously undeclared here, making the whole signature feature dead
             code (any Intent targeting these would crash with
             ActivityNotFoundException). This is the most complete of the three
             signature implementations found in the codebase — it's the only one
             backed by a real PdfSignatureEngine (iText7 PdfSigner for genuine
             PKCS#7 certificate-based signing, plus visual-stamp signing, history,
             and favorites) — so it was chosen as canonical over the other two
             (SecurityActivity's built-in tab, and the forms flow's
             SignatureCaptureDialog). Namespace migration to com.propdf.editor is
             tracked separately (P1); this only makes the feature reachable. -->
        <activity
            android:name="com.propdfeditor.ui.signature.SignatureManagerActivity"
            android:exported="false" />

        <activity
            android:name="com.propdfeditor.ui.signature.ApplySignatureActivity"
            android:exported="false" />

        <activity
            android:name="com.propdfeditor.ui.signature.DrawSignatureActivity"
            android:exported="false" />

        <activity
            android:name="com.propdfeditor.ui.signature.TypeSignatureActivity"
            android:exported="false" />

        <activity
            android:name="com.propdfeditor.ui.signature.CertificateManagerActivity"
            android:exported="false" />

        <activity
            android:name="com.propdfeditor.ui.signature.SignatureVerificationActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
