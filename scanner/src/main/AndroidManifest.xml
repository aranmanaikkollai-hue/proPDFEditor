<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Hardware feature declaration -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application>
        <!-- The presentation.ScannerActivity/ScannerViewModel that used to be
             declared here were fully orphaned (never launched by any code
             path in :app) and have been removed. The real, reachable scanner
             is app's ModernScannerActivity, backed by
             com.propdf.scanner.ui.ScannerViewModel. -->

        <!-- FileProvider is declared in :app's AndroidManifest.xml with the same
             "${applicationId}.fileprovider" authority; its file_paths.xml already
             includes the scanner_original/processed/thumbnails paths that
             scanner_file_paths.xml provided. Declaring it again here causes a
             manifest-merger conflict (duplicate provider, differing meta-data
             resource). -->
    </application>
</manifest>
